[
  {
    "name": "Add Coin",
    "steps": [
      {
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Choose a coin, or enter its ticker."
            }
          }
        ],
        "send": {
          "callback": "add_coin:start"
        }
      },
      {
        "send": { "callback": "add_coin:pick:BTC" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Use Bitcoin as the name, or send your own label." } }
        ]
      },
      {
        "send": { "callback": "add_coin:default" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Add Bitcoin (BTC) to your watchlist?" } }
        ]
      }
    ]
  }
]
